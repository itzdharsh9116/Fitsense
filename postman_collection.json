{
  "info": {
    "name": "FitSense AI / FitTrack AI Backend API Collection",
    "description": "Complete Postman testing collection for the FitSense AI / FitTrack AI RESTful Backend Project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "workoutId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "2. Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "3. Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Workouts",
      "item": [
        {
          "name": "4. Add Workout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workoutName\": \"Morning Running\",\n  \"category\": \"Cardio\",\n  \"duration\": 45,\n  \"caloriesBurned\": 350,\n  \"workoutDate\": \"2026-09-26\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workouts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts"]
            }
          }
        },
        {
          "name": "5. Get All Workouts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/workouts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts"]
            }
          }
        },
        {
          "name": "6. Get Workout By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}"]
            }
          }
        },
        {
          "name": "7. Search Workouts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/workouts/search?name=running&category=Cardio&date=2026-09-26",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "search"],
              "query": [
                {
                  "key": "name",
                  "value": "running"
                },
                {
                  "key": "category",
                  "value": "Cardio"
                },
                {
                  "key": "date",
                  "value": "2026-09-26"
                }
              ]
            }
          }
        },
        {
          "name": "8. Update Workout",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workoutName\": \"Morning Interval Sprint\",\n  \"duration\": 50,\n  \"caloriesBurned\": 400\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}"]
            }
          }
        },
        {
          "name": "9. Delete Workout",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "AI Services",
      "item": [
        {
          "name": "10. Workout Recommendation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 25,\n  \"fitnessGoal\": \"Weight loss\",\n  \"experienceLevel\": \"Beginner\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ai/recommendation",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai", "recommendation"]
            }
          }
        },
        {
          "name": "11. Fitness Insights",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalWorkouts\": 15,\n  \"averageWorkoutDuration\": 42,\n  \"caloriesBurned\": 5250\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ai/insights",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai", "insights"]
            }
          }
        }
      ]
    }
  ]
}
